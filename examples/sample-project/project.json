{
  "schemaVersion": 1,
  "title": "Sample Application Demo",
  "module": "software-demo",
  "sourcePath": "../sample-app",
  "appUrl": "http://127.0.0.1:4173",
  "language": {
    "script": "en",
    "narration": "en-US",
    "subtitles": [
      "en"
    ]
  },
  "review": {
    "mode": "review",
    "featureCoverage": true,
    "storyboard": true,
    "eachScene": true,
    "finalVideo": true
  },
  "voiceover": {
    "enabled": false,
    "provider": "gemini",
    "voice": "Charon",
    "model": "gemini-2.5-flash-preview-tts",
    "style": "Clear and friendly",
    "maxApiCallsPerRun": 5,
    "estimatedUsdPerCall": null
  },
  "render": {
    "engine": "ffmpeg",
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "captionsBurned": true
  },
  "budget": {
    "maxRetryPerScene": 2,
    "maxEstimatedUsd": 2
  },
  "scenes": [
    {
      "id": "scene-01-intro",
      "title": "Dashboard overview",
      "durationSec": 6,
      "featureIds": [
        "dashboard"
      ],
      "narration": "Welcome to our sample learning dashboard.",
      "capture": {
        "actions": [
          {
            "type": "goto",
            "path": "/"
          },
          {
            "type": "waitFor",
            "role": "heading",
            "name": "Learning Dashboard"
          },
          {
            "type": "assertVisible",
            "role": "heading",
            "name": "Learning Dashboard",
            "evidenceId": "dashboard-heading"
          },
          {
            "type": "hover",
            "testId": "overview-card"
          },
          {
            "type": "pause",
            "ms": 1800
          }
        ],
        "evidencePolicy": {
          "requireAssertions": true,
          "failOnPageError": true
        }
      },
      "claims": [
        {
          "id": "dashboard-claim",
          "featureId": "dashboard",
          "text": "our sample learning dashboard",
          "evidenceIds": [
            "dashboard-heading"
          ]
        }
      ]
    },
    {
      "id": "scene-02-feature",
      "title": "Real interactive workflow",
      "durationSec": 8,
      "featureIds": [
        "demo-action"
      ],
      "narration": "Select start demo and see an authentic result appear.",
      "capture": {
        "actions": [
          {
            "type": "goto",
            "path": "/"
          },
          {
            "type": "click",
            "role": "button",
            "name": "Start demo"
          },
          {
            "type": "waitFor",
            "testId": "result-card"
          },
          {
            "type": "assertText",
            "testId": "result-card",
            "expectedText": "Demo result: Your lesson is now ready!",
            "evidenceId": "demo-result-visible",
            "evidenceScreenshot": true
          },
          {
            "type": "hover",
            "testId": "result-card"
          },
          {
            "type": "pause",
            "ms": 2000
          }
        ],
        "evidencePolicy": {
          "requireAssertions": true,
          "failOnPageError": true
        }
      },
      "claims": [
        {
          "id": "result-claim",
          "featureId": "demo-action",
          "text": "see an authentic result appear",
          "evidenceIds": [
            "demo-result-visible"
          ]
        }
      ]
    }
  ],
  "optimization": {
    "profile": "quality"
  },
  "verification": {
    "mode": "claims"
  }
}
